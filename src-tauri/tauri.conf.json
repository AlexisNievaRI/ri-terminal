{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RI Terminal",
  "version": "0.2.1",
  "identifier": "com.bit.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RI Terminal", "width": 1100, "height": 700, "minWidth": 520, "minHeight": 320, "decorations": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMEE4QjMyMTUzQkNFNEQKUldSTnpqc1ZNb3NLb0VrbXRyaG5CVG5VTHBoNUJwNG14Z3N3L0t0VzdxYmdVUkFGcmpkSHdqV2wK",
      "endpoints": ["https://github.com/AlexisNievaRI/ri-terminal/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
